          "name": "1Forge List Available Symbols",
          "request": {
            "name": "1Forge List Available Symbols",
            "description": {
              "content": "Returns the full list of currency pair symbols available to the calling API\nkey. Symbols are expressed in `BASE/QUOTE` notation (e.g. `EUR/USD`).",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "symbols"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your 1Forge API key."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
