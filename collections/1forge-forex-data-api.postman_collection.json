        {
          "id": "df5b2f17-5d5d-49b1-ab64-d4e226b9d788",
          "name": "1Forge Get Quotes for Pairs",
          "request": {
            "name": "1Forge Get Quotes for Pairs",
            "description": {
              "content": "Returns the latest bid, ask, and price data for one or more currency pairs.\nPairs are supplied as a comma-separated list. Either `EUR/USD` or `EURUSD`\nnotation is accepted. Responses are an array of `Quote` objects in the order\nthe pairs were requested.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "quotes"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "pairs",
                  "value": "<string>",
                  "description": "(Required) Comma-separated list of currency pair symbols (e.g. `EUR/USD,GBP/JPY,AUD/USD`)."
                },
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) Your 1Forge API key. Obtain one at https://1forge.com."
                }
              ],
              "variable": []
